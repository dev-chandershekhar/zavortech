# Site
NEXT_PUBLIC_SITE_URL=https://example.com

# Booking: Cal.com link, e.g. yourname/audit. Leave blank to show a notice on /contact.
NEXT_PUBLIC_CAL_LINK=
# Used by every "Book the free audit" button
NEXT_PUBLIC_BOOKING_URL=/contact

# Analytics (Plausible, cookieless). Leave blank to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Contact form email delivery (Resend). Server-side only, never prefix with NEXT_PUBLIC.
RESEND_API_KEY=
CONTACT_TO_EMAIL=zavortech@gmail.com
CONTACT_FROM_EMAIL=
